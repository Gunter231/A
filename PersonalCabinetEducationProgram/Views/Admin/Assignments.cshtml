@model IEnumerable<PersonalCabinetEducationProgram.Models.ApproverAssignment>
@{
    ViewData["Title"] = "Назначения";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Назначения</h4>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Дата</th>
                        <th>Согласующий</th>
                        <th>Тип назначения</th>
                        <th>Куда назначен</th>
                        <th>Кто назначил</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model)
                    {
                        var targetType = assignment.FacultyId != null ? "Факультет" : "Кафедра";
                        var targetName = assignment.Faculty?.Name ?? assignment.Department?.Name ?? "—";
                        <tr>
                            <td>@assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-semibold">@assignment.ApproverUser?.FullName</td>
                            <td>@targetType</td>
                            <td>@targetName</td>
                            <td>@assignment.AssignedByUser?.FullName</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Назначений пока нет</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
