@model IEnumerable<PersonalCabinetEducationProgram.Models.EducationalProgramElementComment>
@{
    ViewData["Title"] = "Комментарии";
    var element = ViewBag.Element as PersonalCabinetEducationProgram.Models.EducationalProgramElement;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" asp-route-programId="@element?.EducationalProgramId" class="text-decoration-none">← Назад к программе</a>
            <h4 class="fw-bold mt-2 mb-0">Комментарии: @element?.Name</h4>
            @if (!string.IsNullOrEmpty(element?.Description))
            {
                <div class="text-muted small">@element.Description</div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            @if (Model.Any())
            {
                @foreach (var comment in Model)
                {
                    <div class="comment-bubble mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;font-size:0.8rem;">
                                    @comment.User?.FullName?.Split(' ').LastOrDefault()?.Substring(0, 1)
                                </div>
                                <div>
                                    <div class="fw-semibold small">@comment.User?.FullName</div>
                                    <div class="text-muted" style="font-size:0.7rem;">@comment.User?.Post</div>
                                </div>
                            </div>
                            <div class="text-muted small" style="font-size:0.72rem;">@comment.DateTimeComment.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                        <div class="small">@comment.CommentContent</div>
                        @if (comment.Status == "Новый")
                        {
                            <div class="mt-1"><span class="badge bg-info-subtle text-info" style="font-size:0.65rem;">Новый</span></div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <div class="fs-1 mb-3">💬</div>
                    <div>Комментариев пока нет</div>
                </div>
            }
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm rounded-4 sticky-top" style="top: 80px;">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Новый комментарий</h6>
                    <form method="post" asp-action="AddComment">
                        <input type="hidden" name="elementId" value="@element?.Id" />
                        <div class="mb-3">
                            <textarea name="commentText" class="form-control" rows="4"
                                      placeholder="Введите ваш комментарий..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Отправить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
