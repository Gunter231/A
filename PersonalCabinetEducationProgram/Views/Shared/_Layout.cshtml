@using PersonalCabinetEducationProgram.Data
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Личный кабинет руководителя ОП</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalCabinetEducationProgram.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="ManagerHome" asp-action="Index">
                    📘 ОПОП Manager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ManagerHome" asp-action="Index">Руководитель</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ApproverHome" asp-action="Index">Согласующий</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ModeratorHome" asp-action="Index">Модератор</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Programs">ОПОП</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">Пользователи</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Departments">Кафедры</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Faculties">Факультеты</a>
                        </li>
                    </ul>

                    @{
                        var fullName = "Иванов И.И.";
                        var post = "Зав. кафедрой";
                        var avatarUrl = "/images/DefaultAvatarUser.png";
                    }

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" href="#">
                                <img src="@avatarUrl"
                                     class="rounded-circle me-2"
                                     width="32" height="32"
                                     alt="Avatar"
                                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><rect fill=%22%236c757d%22 width=%2240%22 height=%2240%22/><text fill=%22white%22 font-size=%2218%22 x=%2250%25%22 y=%2255%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>ИИ</text></svg>'" />
                                <div class="d-flex flex-column" style="line-height: 1.2;">
                                    <span class="text-white fw-semibold small">@fullName</span>
                                    <span class="text-white-50" style="font-size:0.7rem;">@post</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-2" style="background:#f8f9fa;">
        <div class="container text-center small">
            &copy; 2026 Личный кабинет руководителя образовательной программы
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
